---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import WhyUs from "../components/WhyUs.astro";
import Gallery from "../components/Gallery.astro";
import Testimonials from "../components/Testimonials.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { faq, site } from "../data/site.js";
import { business, graph, ids, serviceNodes, webPage, website } from "../data/schema.js";

const url = `${site.url}/`;
const title = "Centro de Estudos em Vila Nova de Gaia · Bloco de Notas";
const description =
  "Centro de estudos em Vila Nova de Gaia, do 1.º ao 9.º ano. Apoio ao estudo, explicações, transporte e refeições, com acompanhamento personalizado.";

// Generated from the same arrays the page renders (services, FAQ), so the
// markup and the page can't drift. See src/data/schema.js.
const jsonLd = graph(
  business,
  website,
  webPage({ url, name: title, description, extra: { mainEntity: { "@id": ids.business } } }),
  ...serviceNodes(),
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    isPartOf: { "@id": `${url}#webpage` },
    inLanguage: "pt-PT",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
);
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  robots="index, follow, max-image-preview:large"
  jsonLd={[jsonLd]}
>
  <Fragment slot="head">
    <!-- Geo / local SEO -->
    <meta name="geo.region" content="PT-13" />
    <meta name="geo.placename" content={site.locality} />
    <meta name="geo.position" content={`${site.lat};${site.lng}`} />
    <meta name="ICBM" content={`${site.lat}, ${site.lng}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta
      property="og:title"
      content="Centro de Estudos em Vila Nova de Gaia · Explicações e Apoio ao Estudo"
    />
    <meta
      property="og:description"
      content="Apoio ao estudo e explicações do 1.º ao 9.º ano em Vila Nova de Gaia. Grupos pequenos, transporte, refeições e acompanhamento personalizado."
    />
    <meta property="og:image" content={site.url + site.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:url" content={`${site.url}/`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Centro de Estudos em Vila Nova de Gaia · Bloco de Notas"
    />
    <meta
      name="twitter:description"
      content="Apoio ao estudo e explicações do 1.º ao 9.º ano em Vila Nova de Gaia. Grupos pequenos, transporte e refeições."
    />
    <meta name="twitter:image" content={site.url + site.ogImage} />

    <link
      rel="preload"
      href="/img/hero-alunos-a-estudar.webp"
      as="image"
      fetchpriority="high"
    />
  </Fragment>

  <Header />
  <main id="conteudo">
    <Hero />
    <Stats />
    <Services />
    <WhyUs />
    <Gallery />
    <Testimonials />
    <LatestPosts />
    <Faq />
    <Contact />
  </main>
  <Footer rating />
</BaseLayout>
