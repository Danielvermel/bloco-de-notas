---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.js";
import { formatDate, getPublishedPosts, readingTime } from "../data/blog.js";

const posts = await getPublishedPosts();
const [latest, ...rest] = posts;

const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog do Bloco de Notas",
  url: `${site.url}/blog`,
  inLanguage: "pt-PT",
  publisher: { "@type": "EducationalOrganization", name: site.name, url: `${site.url}/` },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: `${site.url}/blog/${p.id}`,
    datePublished: p.data.date.toISOString(),
  })),
};
---

<BaseLayout
  title="Blog — Bloco de Notas · Centro de Estudos em Vila Nova de Gaia"
  description="Conselhos práticos para pais e alunos do 1.º ao 9.º ano: métodos de estudo, regresso às aulas, calendário escolar, leitura e muito mais, sempre com fontes."
  canonical={`${site.url}/blog`}
  bodyId="topo"
  bodyClass="page-blog"
  jsonLd={[blogLd]}
>
  <Header prefix="/" homeHref="/" mobileCta />
  <main id="conteudo" class="blog">
    <div class="container">
      <header class="blog-head">
        <span class="eyebrow">Blog</span>
        <h1>Ideias para estudar melhor</h1>
        <p class="lede">
          Conselhos práticos para pais e alunos do Ensino Básico, escritos pela
          equipa do Bloco de Notas. Cada artigo indica as fontes em que se apoia.
        </p>
      </header>

      {
        latest && (
          <a class="post-feature" href={`/blog/${latest.id}`}>
            <img
              src={latest.data.image}
              alt={latest.data.imageAlt}
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
            />
            <div class="post-feature-body">
              <p class="post-meta">
                <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
                · {readingTime(latest.body)} min de leitura
              </p>
              <h2>{latest.data.title}</h2>
              <p>{latest.data.description}</p>
              <span class="post-more">Ler artigo →</span>
            </div>
          </a>
        )
      }

      <ul class="post-grid">
        {
          rest.map((post) => (
            <li>
              <a class="post-card" href={`/blog/${post.id}`}>
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt}
                  width="1200"
                  height="675"
                  loading="lazy"
                />
                <div class="post-card-body">
                  <p class="post-meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    · {readingTime(post.body)} min
                  </p>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer prefix="/" homeHref="/" />
</BaseLayout>

<style is:global>
  .page-blog {
    font-size: 16px;
  }
  .blog {
    padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 96px);
  }
  .blog-head {
    max-width: 680px;
    margin-bottom: clamp(32px, 5vw, 52px);
  }
  .blog-head h1 {
    font-size: clamp(34px, 5vw, 56px);
    margin-bottom: 14px;
  }
  .post-meta {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--teal);
    margin: 0 0 10px;
  }
  .post-feature,
  .post-card {
    display: grid;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--body);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-feature:hover,
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-float);
  }
  .post-feature img,
  .post-card img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .post-feature {
    grid-template-columns: 1.2fr 1fr;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .post-feature-body {
    padding: clamp(22px, 3.5vw, 40px);
    align-self: center;
  }
  .post-feature h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    margin-bottom: 12px;
  }
  .post-more {
    font-weight: 700;
    color: var(--teal);
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.5vw, 28px);
  }
  .post-card {
    height: 100%;
    grid-template-rows: auto 1fr;
  }
  .post-card-body {
    padding: 20px 22px 24px;
  }
  .post-card h3 {
    margin-bottom: 8px;
  }
  .post-card-body p:last-child {
    font-size: 14.5px;
    margin: 0;
  }
  @media (max-width: 960px) {
    .post-feature {
      grid-template-columns: 1fr;
    }
    .post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-feature,
    .post-card {
      transition: none;
    }
    .post-feature:hover,
    .post-card:hover {
      transform: none;
    }
  }
</style>
