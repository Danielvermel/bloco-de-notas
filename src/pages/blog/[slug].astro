---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site.js";
import { formatDate, getPublishedPosts, readingTime } from "../../data/blog.js";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // the two articles around this one, for "Continue a ler"
    props: { post, related: [posts[i - 1], posts[i + 1], posts[i + 2]].filter(Boolean).slice(0, 2) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${site.url}/blog/${post.id}`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  image: site.url + d.image,
  datePublished: d.date.toISOString(),
  inLanguage: "pt-PT",
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: site.name, url: `${site.url}/` },
  publisher: {
    "@type": "EducationalOrganization",
    name: site.name,
    logo: { "@type": "ImageObject", url: `${site.url}/img/logo.png` },
  },
  citation: d.sources.map((s) => s.url),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog` },
    { "@type": "ListItem", position: 3, name: d.title, item: url },
  ],
};
---

<BaseLayout
  title={`${d.title} — Blog do Bloco de Notas`}
  description={d.description}
  canonical={url}
  bodyId="topo"
  bodyClass="page-article"
  jsonLd={[articleLd, breadcrumbLd]}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:title" content={d.title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={site.url + d.image} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="article:published_time" content={d.date.toISOString()} />
  </Fragment>
  <Header prefix="/" homeHref="/" mobileCta />
  <main id="conteudo" class="article">
    <article>
      <header class="container article-head">
        <nav class="crumbs" aria-label="Localização">
          <a href="/">Início</a> <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
        </nav>
        <h1>{d.title}</h1>
        <p class="article-lede">{d.description}</p>
        <p class="post-meta">
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          · {readingTime(post.body)} min de leitura
        </p>
      </header>

      <figure class="container article-figure">
        <img src={d.image} alt={d.imageAlt} width="1200" height="675" fetchpriority="high" />
        <figcaption>
          Foto: <a href={d.imageCredit.sourceUrl} rel="noopener" target="_blank">{d.imageCredit.author}</a>,
          <a href={d.imageCredit.licenseUrl} rel="noopener license" target="_blank">{d.imageCredit.license}</a>
        </figcaption>
      </figure>

      <div class="container prose">
        <Content />

        <aside class="article-cta">
          <h2>Precisa de ajuda com o estudo?</h2>
          <p>
            No Bloco de Notas, em Vila Nova de Gaia, acompanhamos alunos do 1.º ao
            9.º ano em grupos pequenos, com transporte e refeições. Marque uma
            visita, sem compromisso.
          </p>
          <div class="article-cta-actions">
            <a class="btn btn-primary" href="/#contactos">Marcar uma visita</a>
            <a class="article-cta-link" href={site.whatsapp} rel="noopener" target="_blank">WhatsApp {site.phoneSpoken}</a>
          </div>
        </aside>

        <section class="sources" aria-labelledby="fontes">
          <h2 id="fontes">Fontes</h2>
          <ol>
            {
              d.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
                </li>
              ))
            }
          </ol>
          <p class="sources-note">
            Este artigo tem fins informativos e não substitui o aconselhamento
            da escola, do médico ou de outro profissional.
          </p>
        </section>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="container related" aria-labelledby="mais">
          <h2 id="mais">Continue a ler</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id}`}>
                  <img src={r.data.image} alt="" width="1200" height="675" loading="lazy" />
                  <span>{r.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="related-all" href="/blog">Ver todos os artigos →</a>
        </section>
      )
    }
  </main>
  <Footer prefix="/" homeHref="/" />
</BaseLayout>

<style is:global>
  .page-article {
    font-size: 17px;
  }
  .article {
    padding: clamp(32px, 5vw, 60px) 0 clamp(56px, 8vw, 96px);
  }
  .article .container {
    max-width: 780px;
  }
  .article .article-figure {
    max-width: 1000px;
    margin-block: clamp(20px, 3vw, 32px) clamp(28px, 4vw, 44px);
  }
  .crumbs {
    font-size: 14px;
    margin-bottom: 18px;
    color: var(--body);
  }
  .crumbs a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: none;
  }
  .article-head h1 {
    font-size: clamp(32px, 4.6vw, 50px);
    line-height: 1.08;
    margin-bottom: 16px;
  }
  .article-lede {
    font-size: clamp(17px, 1.6vw, 20px);
    margin-bottom: 14px;
  }
  .post-meta {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--teal);
    margin: 0;
  }
  .article-figure img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-img);
  }
  .article-figure figcaption {
    font-size: 12.5px;
    color: var(--body);
    margin-top: 8px;
  }
  .article-figure figcaption a {
    color: inherit;
  }
  .prose h2 {
    font-size: clamp(23px, 2.6vw, 30px);
    margin: 1.8em 0 0.5em;
  }
  .prose h3 {
    margin: 1.5em 0 0.4em;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 0 0 1.1em;
  }
  .prose ul {
    list-style: disc;
    padding-left: 1.3em;
  }
  .prose ol {
    padding-left: 1.4em;
  }
  .prose li {
    margin-bottom: 0.45em;
  }
  .prose a {
    font-weight: 600;
  }
  .prose sup a {
    text-decoration: none;
    font-size: 0.8em;
  }
  .prose blockquote {
    margin: 1.4em 0;
    padding: 4px 0 4px 18px;
    border-left: 3px solid var(--yellow);
    font-style: italic;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.3em;
    font-size: 15px;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 9px 12px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .prose th {
    color: var(--ink);
    background: var(--mint);
  }
  .article-cta {
    background: var(--mint);
    border-radius: var(--radius-card);
    padding: clamp(22px, 3.5vw, 34px);
    margin: 2.4em 0;
  }
  .article-cta h2 {
    margin-top: 0;
  }
  .article-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    align-items: center;
  }
  .article-cta .btn {
    color: #fff;
    text-decoration: none;
  }
  .article-cta-link {
    font-weight: 700;
  }
  .sources {
    border-top: 1px solid var(--hairline);
    padding-top: 8px;
    font-size: 15px;
  }
  .sources h2 {
    font-size: 20px;
  }
  .sources a {
    word-break: break-word;
  }
  .sources-note {
    font-size: 13.5px;
    margin-top: 1em;
  }
  .related {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .related h2 {
    font-size: 24px;
  }
  .related ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  .related li a {
    display: block;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 700;
    line-height: 1.25;
  }
  .related img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 10px;
  }
  .related-all {
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .related ul {
      grid-template-columns: 1fr;
    }
  }
</style>
