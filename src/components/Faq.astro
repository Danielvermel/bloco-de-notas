---
import { faq } from "../data/site.js";
---

<section class="section bg-mint" id="faq">
  <div class="container">
    <div class="section-head is-centered">
      <span class="eyebrow no-bar">Perguntas frequentes</span>
      <h2>Ainda com dúvidas? Respondemos.</h2>
    </div>
    <div class="faq" id="faqList">
      {
        faq.map((item, i) => (
          <div class="faq-item">
            <button class="faq-q" aria-expanded={i === 0 ? "true" : "false"}>
              {item.q}
              <span class="faq-toggle" aria-hidden="true" />
            </button>
            <div class="faq-a">
              <div class="faq-a-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const faqList = document.getElementById("faqList");

  if (faqList) {
    const questions = Array.from(
      faqList.querySelectorAll<HTMLButtonElement>(".faq-q"),
    );

    const setOpen = (btn: HTMLButtonElement, open: boolean) => {
      const answer = btn.nextElementSibling as HTMLElement;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      answer.style.maxHeight = open ? `${answer.scrollHeight}px` : "0px";
      answer.style.opacity = open ? "1" : "0";
    };

    questions.forEach((btn) => {
      // Sync initial state (the first item is open by default in the markup).
      setOpen(btn, btn.getAttribute("aria-expanded") === "true");

      btn.addEventListener("click", () => {
        const willOpen = btn.getAttribute("aria-expanded") !== "true";
        questions.forEach((other) => {
          if (other !== btn) setOpen(other, false);
        });
        setOpen(btn, willOpen);
      });
    });

    // Keep the open panel sized correctly on resize.
    window.addEventListener("resize", () => {
      questions.forEach((btn) => {
        if (btn.getAttribute("aria-expanded") === "true") {
          const answer = btn.nextElementSibling as HTMLElement;
          answer.style.maxHeight = `${answer.scrollHeight}px`;
        }
      });
    });
  }
</script>

<style is:global>
  .faq {
    max-width: 820px;
    margin-inline: auto;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    margin-bottom: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .faq-q {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 18px);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .faq-toggle {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--mint);
    color: var(--teal);
    position: relative;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .faq-toggle::before,
  .faq-toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition:
      transform 0.28s ease,
      opacity 0.28s ease;
  }
  .faq-toggle::before {
    width: 12px;
    height: 2px;
  }
  .faq-toggle::after {
    width: 2px;
    height: 12px;
  }
  .faq-q[aria-expanded="true"] .faq-toggle {
    background: var(--teal);
    color: #fff;
  }
  .faq-q[aria-expanded="true"] .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }
  .faq-a {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.38s ease,
      opacity 0.38s ease;
  }
  .faq-a-inner {
    padding: 0 22px 22px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.62;
  }
  .faq-a-inner p {
    margin: 0;
  }
</style>
