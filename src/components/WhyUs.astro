---
import { whyUs } from "../data/site.js";
---

<section class="section bg-mint" id="porque-nos">
  <div class="container why-grid">
    <div class="why-sticky">
      <span class="eyebrow">Porquê Nós</span>
      <h2>Sem promessas exageradas. Apenas progresso consistente.</h2>
      <p class="lede">
        Cada criança aprende de forma diferente. Por isso dedicamo-nos a
        entender as necessidades de cada aluno, com apoio personalizado e
        adaptado ao ritmo de cada um.
      </p>
      <div class="pledge">
        <span class="pledge-label">Compromisso Bloco de Notas</span>
        <p>
          Comprometemo-nos com um acompanhamento próximo, honesto e consistente,
          e com resultados construídos passo a passo.
        </p>
      </div>
    </div>
    <ol class="why-list">
      {
        whyUs.map((item, i) => (
          <li>
            <span class="why-num">{String(i + 1).padStart(2, "0")}</span>
            <div class="why-item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .why-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }
  .why-sticky {
    position: sticky;
    top: calc(var(--header-h) + 28px);
  }
  .pledge {
    margin-top: 28px;
    background: #fff;
    border: 1px solid var(--hairline);
    border-left: 4px solid var(--yellow);
    border-radius: 14px;
    padding: 20px 22px;
    box-shadow: var(--shadow-card);
  }
  .pledge-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 8px;
  }
  .pledge p {
    margin: 0;
    font-size: 15px;
    color: var(--body);
  }

  .why-list li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 20px;
    padding: 26px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .why-list li:first-child {
    padding-top: 0;
  }
  .why-list li:last-child {
    border-bottom: none;
  }
  .why-num {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 22px;
    color: var(--teal);
    line-height: 1.1;
  }
  .why-item h3 {
    margin-bottom: 6px;
  }
  .why-item p {
    color: var(--body);
    margin: 0;
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
    .why-sticky {
      position: static;
    }
  }
  @media (max-width: 600px) {
    .why-list li {
      grid-template-columns: 36px 1fr;
      gap: 12px;
    }
  }
</style>
