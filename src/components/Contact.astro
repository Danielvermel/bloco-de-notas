---
import { formEndpoint, interesses, site } from "../data/site.js";
---

<section class="section" id="contactos">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contactos</span>
      <h2>Venha conhecer-nos</h2>
      <p class="lede">
        Estamos a um telefonema de distância. Marque uma visita sem compromisso
        e conheça o espaço.
      </p>
    </div>
    <div class="contact-grid">
      <div>
        <ul class="contact-rows">
          <li class="contact-row">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"
                ><path
                  d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path><circle
                  cx="12"
                  cy="10"
                  r="2.5"
                  stroke="currentColor"
                  stroke-width="1.7"></circle></svg
              >
            </span>
            <div class="contact-text">
              <span class="contact-label">Morada</span><span class="contact-value"
                ><a href={site.mapsLink} rel="noopener" target="_blank"
                  >{site.street}, {site.locality}</a
                ></span
              >
            </div>
          </li>
          <li class="contact-row">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"
                ><path
                  d="M6.5 4h3l1.3 3.2-1.9 1.2a11 11 0 0 0 4.5 4.5l1.2-1.9L18 12.5v3a1.5 1.5 0 0 1-1.6 1.5A12.5 12.5 0 0 1 5 5.6 1.5 1.5 0 0 1 6.5 4Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path></svg
              >
            </span>
            <div class="contact-text">
              <span class="contact-label">Telemóvel</span><span
                class="contact-value"><a href={site.phoneHref}>{site.phone}</a></span
              >
            </div>
          </li>
          <li class="contact-row">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"
                ><rect
                  x="3.5"
                  y="5.5"
                  width="17"
                  height="13"
                  rx="2.5"
                  stroke="currentColor"
                  stroke-width="1.7"></rect><path
                  d="m4.5 7 7.5 5.5L19.5 7"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"></path></svg
              >
            </span>
            <div class="contact-text">
              <span class="contact-label">Email</span><span class="contact-value"
                ><a href={`mailto:${site.email}`}>{site.email}</a></span
              >
            </div>
          </li>
          <li class="contact-row">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"
                ><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7"
                ></circle><path
                  d="M12 7.5V12l3 2"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </span>
            <div class="contact-text">
              <span class="contact-label">Horário</span><span class="contact-value"
                >{site.hours}</span
              >
            </div>
          </li>
        </ul>
        <div class="contact-actions">
          <a class="btn btn-primary" href={site.phoneHref}>
            <svg viewBox="0 0 24 24" fill="none"
              ><path
                d="M6.5 4h3l1.3 3.2-1.9 1.2a11 11 0 0 0 4.5 4.5l1.2-1.9L18 12.5v3a1.5 1.5 0 0 1-1.6 1.5A12.5 12.5 0 0 1 5 5.6 1.5 1.5 0 0 1 6.5 4Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path></svg
            >
            Ligar agora
          </a>
          <a class="btn btn-outline" href={site.whatsapp} rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Zm0 1.8a7.2 7.2 0 1 1-3.7 13.4l-.3-.2-2.4.6.6-2.3-.2-.3A7.2 7.2 0 0 1 12 4.8Zm-2.3 3c-.2 0-.5 0-.7.4-.2.4-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.7 2.8 4.3 3.8 2.1.8 2.5.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.6-.3c-.3-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.7-.3-1.4-.6-2.1-1.5-.5-.6-.8-1.3-.9-1.5-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.4c0-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.4Z"
              ></path></svg
            >
            WhatsApp
          </a>
        </div>
        <div class="social-row">
          <a
            class="social-btn"
            href={site.instagram}
            rel="noopener"
            target="_blank"
            aria-label="Instagram do Bloco de Notas"
          >
            <svg viewBox="0 0 24 24" fill="none"
              ><rect
                x="3.5"
                y="3.5"
                width="17"
                height="17"
                rx="5"
                stroke="currentColor"
                stroke-width="1.7"></rect><circle
                cx="12"
                cy="12"
                r="3.6"
                stroke="currentColor"
                stroke-width="1.7"></circle><circle
                cx="17.2"
                cy="6.8"
                r="1.2"
                fill="currentColor"></circle></svg
            >
          </a>
          <a
            class="social-btn"
            href={site.facebook}
            rel="noopener"
            target="_blank"
            aria-label="Facebook do Bloco de Notas"
          >
            <svg viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M14 8.5V7c0-.8.5-1 1-1h1.5V3H14c-2.2 0-3.7 1.4-3.7 3.7V8.5H8v3h2.3V21h3.4v-9.5h2.4l.4-3H14Z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Wired to Formspree. If the action ever falls back to a placeholder,
           the submit handler opens the visitor's mail client instead. -->
      <form
        class="contact-form"
        id="contactForm"
        action={formEndpoint}
        method="post"
        data-email={site.email}
        data-phone={site.phoneSpoken}
        novalidate
      >
        <div class="field">
          <label for="cf-nome">Nome</label>
          <input id="cf-nome" name="nome" type="text" autocomplete="name" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="cf-email">Email</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="field">
            <label for="cf-tel">Telemóvel</label>
            <input
              id="cf-tel"
              name="telemovel"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
            />
          </div>
        </div>
        <div class="field">
          <label for="cf-interesse">Interesse</label>
          <select id="cf-interesse" name="interesse" required>
            <option value="" disabled selected>Selecione uma opção</option>
            {interesses.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="cf-msg">Mensagem</label>
          <textarea
            id="cf-msg"
            name="mensagem"
            required
            placeholder="Conte-nos o ano de escolaridade e o que procura."></textarea>
        </div>
        <!-- honeypot anti-spam -->
        <div class="form-hp" aria-hidden="true">
          <label
            >Não preencher<input
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>
        <div class="form-consent">
          <input id="cf-consent" name="consentimento" type="checkbox" required />
          <label for="cf-consent"
            >Li e aceito a <a href="/privacidade">Política de Privacidade</a
            > e autorizo o Bloco de Notas a contactar-me sobre este pedido.</label
          >
        </div>
        <button class="btn btn-primary btn-block" type="submit" id="cf-submit"
          >Enviar mensagem</button
        >
        <p class="form-note">Não partilhamos os seus dados com terceiros.</p>
        <div class="form-status" id="formStatus" role="status" aria-live="polite">
        </div>
      </form>
    </div>

    <div class="map-embed">
      <iframe
        src={site.mapsEmbed}
        title="Mapa com a localização do Bloco de Notas, Rua de Laborim 70, Vila Nova de Gaia"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const status = document.getElementById("formStatus");
  const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;

  if (form && status) {
    // Carried on the form so the bundle doesn't have to import the data module.
    const email = form.dataset.email;
    const phone = form.dataset.phone;
    const CONFIGURED = form.action.indexOf("REPLACE_WITH_FORM_ID") === -1;

    const showStatus = (kind: string, message: string) => {
      status.className = `form-status is-${kind}`;
      status.textContent = message;
    };

    const buildMailto = () => {
      const d = new FormData(form);
      const lines = [
        `Nome: ${d.get("nome") || ""}`,
        `Email: ${d.get("email") || ""}`,
        `Telemóvel: ${d.get("telemovel") || ""}`,
        `Interesse: ${d.get("interesse") || ""}`,
        "",
        String(d.get("mensagem") || ""),
      ];
      return (
        `mailto:${email}` +
        `?subject=${encodeURIComponent(`Contacto pelo site: ${d.get("nome") || ""}`)}` +
        `&body=${encodeURIComponent(lines.join("\n"))}`
      );
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Honeypot: silently accept bots without sending.
      const gotcha = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      if (gotcha?.value) {
        showStatus("success", "Obrigado! A sua mensagem foi enviada.");
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Fallback while no backend is configured: open the visitor's mail client.
      if (!CONFIGURED) {
        window.location.href = buildMailto();
        showStatus(
          "success",
          `Abrimos o seu email com a mensagem pronta a enviar. Se não abriu, escreva para ${email}.`,
        );
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "A enviar…";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.reset();
          showStatus(
            "success",
            "Obrigado! A sua mensagem foi enviada. Entraremos em contacto brevemente.",
          );
        } else {
          showStatus(
            "error",
            `Não foi possível enviar. Ligue-nos para ${phone} ou escreva para ${email}.`,
          );
        }
      } catch {
        showStatus(
          "error",
          `Sem ligação no momento. Ligue-nos para ${phone} ou escreva para ${email}.`,
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar mensagem";
      }
    });
  }
</script>

<style is:global>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 4.5vw, 56px);
    align-items: start;
  }
  .contact-rows {
    margin: 26px 0;
  }
  .contact-row {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .contact-row:first-child {
    padding-top: 0;
  }
  .contact-icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--mint);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-icon svg {
    width: 20px;
    height: 20px;
  }
  .contact-label {
    display: block;
    font-weight: 700;
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.02em;
    margin-bottom: 2px;
  }
  .contact-value {
    display: block;
    margin: 0;
    color: var(--body);
  }
  .contact-row a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }
  .contact-row a:hover {
    text-decoration: underline;
  }
  .contact-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .social-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .social-btn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--teal);
    text-decoration: none;
    transition:
      background-color 0.16s ease,
      color 0.16s ease,
      transform 0.16s ease;
  }
  .social-btn:hover {
    background: var(--teal);
    color: #fff;
    transform: translateY(-2px);
  }
  .social-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Form */
  .contact-form {
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: clamp(22px, 3vw, 32px);
    box-shadow: var(--shadow-card);
  }
  .field {
    margin-bottom: 16px;
  }
  .field label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 7px;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    padding: 12px 14px;
    border: 1.5px solid var(--hairline);
    border-radius: var(--radius-input);
    background: #fff;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(14, 95, 85, 0.12);
  }
  .field textarea {
    min-height: 120px;
    resize: vertical;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .form-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 4px 0 18px;
  }
  .form-consent input {
    margin-top: 2px;
    width: 18px;
    height: 18px;
    flex: none;
    accent-color: var(--teal);
    cursor: pointer;
  }
  .form-consent label {
    font-size: 13px;
    color: var(--body);
    line-height: 1.5;
    font-weight: 500;
  }
  .form-consent a {
    color: var(--teal);
    font-weight: 700;
  }
  .form-note {
    font-size: 12.5px;
    color: var(--body);
    margin: 12px 0 0;
  }
  .form-status {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 14px;
    font-size: 14.5px;
    display: none;
  }
  .form-status.is-success {
    display: block;
    background: var(--mint);
    color: var(--teal-dark);
    border: 1px solid var(--hairline);
  }
  .form-status.is-error {
    display: block;
    background: #fceded;
    color: #a02020;
    border: 1px solid rgba(160, 32, 32, 0.2);
  }

  .map-embed {
    margin-top: clamp(32px, 4vw, 48px);
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    aspect-ratio: 16/6;
    background: var(--mint);
    box-shadow: var(--shadow-card);
  }
  .map-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .contact-row {
      align-items: flex-start;
      border-bottom: none;
    }
  }
</style>
