---
import { stats } from "../data/site.js";
---

<section class="stats" aria-label="Bloco de Notas em números">
  <div class="container">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="stat-num">
            {s.value}
            {s.suffix && <span class="st">{s.suffix}</span>}
          </span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  .stats {
    background: var(--teal-dark);
    color: #fff;
  }
  .stats .container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-block: clamp(34px, 4.5vw, 52px);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-inline: 6px;
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }
  .stat:first-child {
    border-left: none;
    padding-left: 0;
  }
  .stat-num {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1;
    color: var(--yellow);
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }
  .stat-num .st {
    font-size: 0.7em;
  }
  .stat-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .stats .container {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px 20px;
    }
    .stat:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
