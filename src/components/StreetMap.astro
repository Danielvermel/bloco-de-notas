---
/**
 * Map of the streets around the centre, drawn from OpenStreetMap data
 * (src/data/street-map.json, built by scripts/build-street-map.mjs).
 * Units are metres and (0, 0) is the door at Rua de Laborim, 70; the
 * viewBox crops around it and "slice" keeps the door centred at any shape.
 */
import { site } from "../data/site.js";
import map from "../data/street-map.json";

// Casing first, then fill, from the widest road class to the narrowest.
const ROADS = ["path", "service", "minor", "tertiary", "secondary", "primary", "motorway"];
const roadsOf = (cls) => map.roads[cls] ?? [];

const NAMED_STOPS = new Set(["Laborim - Semáforos", "Laborim - UTIC"]);

// Bus stops come as one node per side of the road: keep one per name.
const stops = [];
for (const [x, y, name] of map.stops) {
  if (!stops.some((s) => s[2] === name && (NAMED_STOPS.has(name) || Math.hypot(s[0] - x, s[1] - y) < 60)))
    stops.push([x, y, name]);
}

// House numbers next to the door would sit under the callout.
const numbers = map.numbers.filter(([x, y]) => !(x > -12 && x < 175 && y > -75 && y < -8));
---

<svg
  class="street-map"
  viewBox="-360 -230 720 460"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={`Mapa das ruas à volta do Bloco de Notas, ${site.street}, ${site.locality}`}
>
  <rect x="-700" y="-500" width="1400" height="1000" class="m-ground"></rect>

  <g class="m-green">{map.green.map((d) => <path d={d}></path>)}</g>
  <g class="m-school">{map.school.map((d) => <path d={d}></path>)}</g>
  <g class="m-buildings">{map.buildings.map((d) => <path d={d}></path>)}</g>

  <g class="m-roads">
    {ROADS.map((cls) => <g class={`m-case m-${cls}`}>{roadsOf(cls).map((d) => <path d={d}></path>)}</g>)}
    {ROADS.map((cls) => <g class={`m-fill m-${cls}`}>{roadsOf(cls).map((d) => <path d={d}></path>)}</g>)}
  </g>

  <g class="m-numbers">
    {numbers.map(([x, y, n]) => <text x={x} y={y}>{n}</text>)}
  </g>

  <g class="m-labels">
    {map.labels.map((l, i) => <path id={`m-l${i}`} d={l.d} fill="none"></path>)}
    {map.labels.map((l, i) => (
      <text class:list={{ "m-label-main": l.name === "Rua de Laborim" }}>
        <textPath href={`#m-l${i}`} startOffset="50%" text-anchor="middle" dominant-baseline="central">
          {l.name}
        </textPath>
      </text>
    ))}
  </g>

  <g class="m-stops">
    {stops.map(([x, y, name]) => (
      <g>
        <circle cx={x} cy={y} r="3.6"></circle>
        {NAMED_STOPS.has(name) && <text x={x - 7} y={y + 3}>{name.replace(" - ", " · ")}</text>}
      </g>
    ))}
  </g>

  <!-- The door, and a callout tied to it by a leader line -->
  <g class="m-marker">
    <circle class="m-ring" cx="0" cy="0" r="7"></circle>
    <path class="m-pin" d="M0 0 C-3 -6 -8 -9 -8 -15 A8 8 0 0 1 8 -15 C8 -9 3 -6 0 0 Z"></path>
    <circle cx="0" cy="-15" r="2.8" fill="#fff"></circle>
  </g>
  <g class="m-callout">
    <path class="m-leader" d="M5 -20 L22 -36"></path>
    <rect x="22" y="-66" width="160" height="44" rx="6"></rect>
    <text class="m-callout-name" x="32" y="-47">Bloco de Notas</text>
    <text class="m-callout-addr" x="32" y="-32">{site.street}, {site.locality}</text>
  </g>
</svg>

<style is:global>
  .street-map {
    display: block;
    width: 100%;
    height: 100%;
    --m-ground: #f6f3ec;
    --m-building: #e4ded2;
    --m-building-edge: #d5cdbd;
    --m-label: #5c5446;
    --m-halo: #f6f3ec;
  }
  .street-map .m-ground {
    fill: var(--m-ground);
  }
  .street-map .m-green path {
    fill: #dcead3;
  }
  .street-map .m-school path {
    fill: #efe5cf;
  }
  .street-map .m-buildings path {
    fill: var(--m-building);
    stroke: var(--m-building-edge);
    stroke-width: 0.6;
  }

  .street-map .m-roads path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .street-map .m-case path {
    stroke: #cbc2b0;
  }
  .street-map .m-fill path {
    stroke: #fff;
  }
  .street-map .m-motorway.m-case path { stroke: #d39b8f; stroke-width: 17; }
  .street-map .m-motorway.m-fill path { stroke: #efc1b6; stroke-width: 14; }
  .street-map .m-primary.m-case path { stroke: #d8b06d; stroke-width: 13; }
  .street-map .m-primary.m-fill path { stroke: #f6d9a4; stroke-width: 10.5; }
  .street-map .m-secondary.m-case path { stroke: #d6c27c; stroke-width: 12; }
  .street-map .m-secondary.m-fill path { stroke: #f8ebb8; stroke-width: 9.5; }
  .street-map .m-tertiary.m-case path { stroke-width: 11; }
  .street-map .m-tertiary.m-fill path { stroke-width: 8.6; }
  .street-map .m-minor.m-case path { stroke-width: 8.5; }
  .street-map .m-minor.m-fill path { stroke-width: 6.6; }
  .street-map .m-service.m-case path { stroke-width: 4.6; }
  .street-map .m-service.m-fill path { stroke-width: 3.2; }
  .street-map .m-path.m-case path { stroke: none; }
  .street-map .m-path.m-fill path {
    stroke: #b4a993;
    stroke-width: 1;
    stroke-dasharray: 3 2.5;
  }

  .street-map text {
    font-family: var(--font-body);
  }
  .street-map .m-numbers text {
    font-size: 6px;
    fill: #8f8574;
    text-anchor: middle;
  }
  .street-map .m-labels text {
    font-size: 8.5px;
    font-weight: 600;
    fill: var(--m-label);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 2.6px;
    stroke-linejoin: round;
  }
  .street-map .m-labels .m-label-main {
    font-size: 10px;
    font-weight: 700;
    fill: var(--ink);
  }
  .street-map .m-stops circle {
    fill: #fff;
    stroke: var(--teal);
    stroke-width: 1.8;
  }
  .street-map .m-stops text {
    font-size: 7.5px;
    font-weight: 600;
    fill: var(--teal-dark);
    text-anchor: end;
    paint-order: stroke;
    stroke: var(--m-halo);
    stroke-width: 2.4px;
  }

  .street-map .m-pin {
    fill: var(--teal);
    stroke: #fff;
    stroke-width: 1.4;
  }
  .street-map .m-ring {
    fill: var(--teal);
    opacity: 0.18;
  }
  .street-map .m-leader {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.4;
  }
  .street-map .m-callout rect {
    fill: #fff;
    stroke: var(--teal);
    stroke-width: 1.2;
    filter: drop-shadow(0 3px 5px rgba(10, 60, 55, 0.18));
  }
  .street-map .m-callout-name {
    font-family: var(--font-head);
    font-size: 12.5px;
    font-weight: 800;
    fill: var(--teal-dark);
  }
  .street-map .m-callout-addr {
    font-size: 8.5px;
    font-weight: 600;
    fill: var(--body);
  }
  .street-map .m-marker,
  .street-map .m-callout {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* Phones show a smaller slice at a smaller scale: bring the type up. */
  @media (max-width: 600px) {
    .street-map .m-labels text { font-size: 12px; }
    .street-map .m-labels .m-label-main { font-size: 14px; }
    .street-map .m-numbers text { font-size: 8px; }
    .street-map .m-stops text { display: none; }
    .street-map .m-marker,
    .street-map .m-callout {
      transform: scale(1.2);
    }
  }

  /* When the map scrolls into view the pin drops onto the door, a ring
     ripples once from it, and the callout follows. */
  @keyframes m-drop {
    from { opacity: 0; translate: 0 -14px; }
  }
  @keyframes m-ripple {
    from { r: 3; opacity: 0.45; }
    to { r: 22; opacity: 0; }
  }
  @keyframes m-fade {
    from { opacity: 0; }
  }
  .map-embed[data-reveal="shown"] .m-pin {
    animation: m-drop 0.45s var(--ease-out) 0.3s backwards;
  }
  .map-embed[data-reveal="shown"] .m-ring {
    animation: m-ripple 1s var(--ease-out) 0.7s backwards;
  }
  .map-embed[data-reveal="shown"] .m-callout {
    animation: m-fade 0.4s var(--ease-out) 0.75s backwards;
  }
</style>
